rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data, userId) {
      return data.uid == userId &&
        data.email is string &&
        data.email.size() <= 256;
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
        (data.type == 'BUY' || data.type == 'SELL') &&
        data.amountBtc is number &&
        data.amountBtc > 0 &&
        data.pricePerBtcUsd is number &&
        data.pricePerBtcUsd > 0 &&
        data.date is string &&
        data.date.size() <= 32;
    }

    function isValidAnalysis(data, userId) {
      return data.userId == userId &&
        data.totalBtc is number &&
        data.analysisText is string &&
        data.analysisText.size() <= 10000;
    }

    function isValidAlert(data, userId) {
      return data.userId == userId &&
        data.title is string &&
        data.title.size() <= 128 &&
        data.condition is string &&
        data.targetValue is number &&
        data.active is bool;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidUser(incoming(), userId) && incoming().uid == resource.data.uid;
      allow delete: if false;

      // User transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId) && incoming().userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }

      // User personal portfolio analyses
      match /analyses/{analysisId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(analysisId) && isValidAnalysis(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(analysisId) && isValidAnalysis(incoming(), userId) && incoming().userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }

      // User custom alerts
      match /alerts/{alertId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(alertId) && isValidAlert(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(alertId) && isValidAlert(incoming(), userId) && incoming().userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
